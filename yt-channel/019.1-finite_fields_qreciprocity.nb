 RowBox[{
  RowBox[{
   RowBox[{"0", " ", "+", "a"}], " ", "=", " ", "a"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"for", " ", "any", " ", "a", " ", "there", " ", "is", "  ", 
