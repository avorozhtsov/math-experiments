Cell[CellGroupData[{

Cell["Rows of multiplication and sum- tables are permutations", \
"Subsubsection",
 CellChangeTimes->{{3.8842440309842052`*^9, 
  3.8842440833753643`*^9}},ExpressionUUID->"c98d5163-7359-4d29-a9ca-\
9641313e7610"],

Cell[TextData[{
 "if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "*", "b"}], "\[Equal]", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "dd47eb17-0f2b-4297-bb92-caa7fefccd07"],
 "\nthen \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "*", "b"}], ")"}], "*", "c"}], "\[Equal]", "c"}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "47c021bb-71ca-421b-abe3-9160b0bdee3a"],
 "\nand then\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "*", 
     RowBox[{"(", 
      RowBox[{"b", "*", "c"}], ")"}]}], "\[Equal]", "c"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "608ba337-057a-4b76-ac59-ce4d138c7fd4"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "*", "d"}], "\[Equal]", "c"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "7fff734c-70fd-4f1c-9665-db45ed33489d"],
 "\nso for any ",
 StyleBox["a",
  FontWeight->"Bold"],
 " and ",
 StyleBox["c",
  FontWeight->"Bold"],
 ", ",
 StyleBox["a",
  FontWeight->"Bold"],
 " \[NotEqual] 0, and ",
 StyleBox["c",
  FontWeight->"Bold"],
 " \[NotEqual] 0,  there is ",
 StyleBox["d",
  FontWeight->"Bold"],
 "  such that ",
 StyleBox["a * d == c.\nSo each row of multiplication table contains all \
numbers from {0,1,..., p-1}.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.884222176980747*^9, 3.884222436402547*^9}, {
  3.8842364617682543`*^9, 3.884236529558362*^9}, {3.884237582263874*^9, 
  3.884237587401269*^9}, {3.884237747408102*^9, 3.884237748289639*^9}, {
  3.88424409139563*^9, 
  3.8842440938838797`*^9}},ExpressionUUID->"98695a4d-ef9d-49f6-8324-\
91ab6de2a086"]
}, Open  ]],

