     RowBox[{
      StyleBox["Q",
       FontSlant->"Italic"], " ", "are", " ", "polinomials"}], " ", ",", " ", 
     
     RowBox[{"coeffs", " ", "in", " ", "\[DoubleStruckCapitalR]"}], ",", 
