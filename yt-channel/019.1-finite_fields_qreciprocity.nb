    RowBox[{"(", 
     RowBox[{"a", " ", "*", " ", "b"}], ")"}], " ", "*", " ", "c"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "*", "b"}], " ", "==", " ", 
