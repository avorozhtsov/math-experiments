Cell[TextData[{
 "Lets denote \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    StyleBox[
     RowBox[{"-", "a"}],
     FontWeight->"Bold"]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "bd83371a-f38f-42ae-b609-d118a16a197b"],
 " \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "+", "b"}], "=", "0"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "3f78d895-ba46-426c-92fb-31d12bc2167b"],
 " \nand define ",
 StyleBox["subtraction :",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "-", 
    RowBox[{"c", " ", "means", " ", "a"}], "+", " ", 
    RowBox[{"(", 
     RowBox[{"-", "c"}], ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "f2babb65-c629-4505-8155-053f22c3b877"],
 " \n\nLets denote \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    SuperscriptBox[
     StyleBox["a",
      FontWeight->"Bold"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "dade511b-0791-43c3-b46f-405792f9fb37"],
 " \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "*", "b"}], "=", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "5b856d0f-bd18-4d88-bce1-d450bc2e05b9"],
 " \nand define ",
 StyleBox["devision :",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "/", "c"}], " ", "means", " ", "a", "*", " ", 
    RowBox[{"(", 
     SuperscriptBox["c", 
      RowBox[{"-", "1"}]], ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "4034f0fb-7b8e-4608-b746-705158945eb0"],
 " \n\n----------\nProve:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"-", "a"}], ")"}]}], "==", "a", " "}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6d26b47f-956d-4ab2-9ab0-6c4690a7c50c"],
 ":\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "+", 
     RowBox[{"(", 
      RowBox[{"-", "a"}], ")"}]}], "\[Equal]", "0", " "}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "3af812e8-0c41-45a3-8812-07cb375b7aaa"],
 ":\nProve:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "a"}], "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "*", "a", " "}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b94e9fbd-71b4-4c3b-a747-11b17baad770"],
 ":\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "*", "a"}], "+", "a", " "}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "59d2e82d-7834-48db-8191-21d53c07bd77"],
 Cell[BoxData[
  FormBox[
   RowBox[{"==", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "*", "a"}], "+", 
     RowBox[{"1", "*", "a"}]}], " ", "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "+", " ", "1"}], ")"}], "*", "a"}], 
    "\[Equal]", 
    RowBox[{"0", " ", "*", " ", "a"}], " ", "\[Equal]", " ", "0"}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "794fcc02-1b59-4613-86cc-292e27e8cafe"],
 ",\nProve:   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"a", "*", "b"}], ")"}]}], "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "a"}], ")"}], "*", "b", " "}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "a4be70ce-079e-48df-8a51-8a306bef9743"],
 "\[LineSeparator]\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"a", "*", "b"}], ")"}]}], "\[Equal]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"a", "*", "b"}], ")"}]}], "\[Equal]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], " ", "*", "a"}], ")"}], "*", "b"}]}], " ",
     "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "a"}], ")"}], " ", "*", "b", "  "}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "5ca3e6a8-fe04-4a61-823e-79370d61828b"]
}], "Text",
 CellChangeTimes->{{3.884236588447253*^9, 3.8842366891386557`*^9}, {
