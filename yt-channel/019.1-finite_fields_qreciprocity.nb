Cell[BoxData[
 RowBox[{
  RowBox[{"JacobiSim2Table", "[", "primes_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", " ", "p", ",", "q"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{
        "primes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{
        "primes", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"JacobiSymbol", "[", 
         RowBox[{"p", ",", "q"}], "]"}], "*", 
        RowBox[{"JacobiSymbol", "[", 
         RowBox[{"q", ",", "p"}], "]"}], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{
          FractionBox[
           RowBox[{"p", "-", "1"}], "2"], 
          FractionBox[
           RowBox[{"q", "-", "1"}], "2"]}]]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "primes", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "primes", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

