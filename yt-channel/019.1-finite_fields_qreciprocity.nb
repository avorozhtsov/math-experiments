     RowBox[{
      RowBox[{"a", " ", "+", " ", "b"}], " ", "\[Equal]", "0"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", " ", "*", " ", 
    RowBox[{"(", 
     RowBox[{"b", " ", "*", " ", "c"}], ")"}]}], " ", "=", " ", 
