Cell[CellGroupData[{

Cell["Jacobi Symbol \[Dash] extension of Legendre Symbol for not primes", \
"Subsection",
 CellChangeTimes->{{3.8841449094306993`*^9, 3.884144915163273*^9}, {
   3.88414528123319*^9, 3.884145300770226*^9}, 
   3.884256262325994*^9},ExpressionUUID->"2847ba50-7a18-46ba-a747-\
2139600f68fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JacobiSymbol", "[", 
   RowBox[{"m", ",", " ", "p"}], "]"}], " ", "\[Equal]", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
     "\"\<\!\(\*StyleBox[SuperscriptBox[\"x\", \"2\"], \"InlineFormula\"]\)\!\
\(\*StyleBox[\"\[Equal]\", \"InlineFormula\"]\)\!\(\*StyleBox[\"m\", \
\"InlineFormula\"]\)\!\(\*StyleBox[\" \", \"InlineFormula\"]\)\!\(\*StyleBox[\
\"mod\", \"InlineFormula\"]\)\!\(\*StyleBox[\" \", \
\"InlineFormula\"]\)\!\(\*StyleBox[\"p\", \"InlineFormula\"]\)\!\(\*StyleBox[\
\"\\\"\", \"InlineFormula\"]\)", " ", "has", " ", "solutions"}], ")"}], ",", 
    " ", "1", ",", " ", 
    RowBox[{"-", "1"}]}], "]"}]}]], "Text",
 CellChangeTimes->{{3.884145156528728*^9, 
  3.884145235437635*^9}},ExpressionUUID->"1a6fec3f-35e3-4114-a8f0-\
58bd23fa353b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", " ", "=", 
   RowBox[{"3", " ", "3", " ", "3"}]}], " ", ";", " ", 
  RowBox[{"b", " ", "=", 
   RowBox[{"5", " ", "5"}]}], " ", ";", " ", 
  RowBox[{"c", "=", " ", "7"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JacobiSymbol", "[", 
   RowBox[{
    RowBox[{"a", " ", "*", " ", "b"}], ",", " ", "c"}], "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"JacobiSymbol", "[", 
    RowBox[{"a", ",", " ", "c"}], "]"}], "*", 
   RowBox[{"JacobiSymbol", "[", 
    RowBox[{"b", ",", " ", "c"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JacobiSymbol", "[", 
   RowBox[{"c", ",", 
    RowBox[{"a", " ", "*", " ", "b"}]}], "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"JacobiSymbol", "[", 
    RowBox[{"c", ",", " ", "a"}], "]"}], "*", 
   RowBox[{"JacobiSymbol", "[", 
    RowBox[{"c", ",", " ", "b"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.884144932542625*^9, 3.884144967074641*^9}, {
  3.8841450150168877`*^9, 3.88414513251307*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"d940406b-d573-4707-9e04-c1c48b895cc8"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.88491951883335*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"b4fa2fa2-f9ba-43a2-8a99-1ce8616bb0ea"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.884919518862191*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"8c4271b8-8e8b-4534-b706-4eb9776c5b87"]
}, Open  ]],

