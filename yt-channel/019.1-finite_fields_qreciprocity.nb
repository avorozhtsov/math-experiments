Cell[BoxData[{
 RowBox[{
  RowBox[{"primes", "=", 
   RowBox[{"Prime", "[", 
    RowBox[{"Range", "[", "3000", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{"RandomChoice", "[", "primes", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"RandomChoice", "[", "primes", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"p", ",", "q", ",", " ", 
         RowBox[{"JacobiSymbol", "[", 
          RowBox[{"p", ",", "q"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
      ")"}], "&"}], "/@", 
    RowBox[{"Range", "[", "10000", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.884143525321562*^9, 3.884143643658971*^9}, 
   3.88491908750189*^9},
 CellLabel->"In[63]:=",ExpressionUUID->"760fecda-a821-4cd4-aee9-67835d93173d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fs", ",", " ", "target"}], "}"}], " ", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p", ",", "q", ",", "t"}], "}"}], "=", "#"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", " ", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"p", ",", "3"}], "]"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"p", ",", "5"}], "]"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"q", ",", "3"}], "]"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"q", ",", "5"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"p", "-", "1"}], "2"], ",", "2"}], "]"}], ",", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"q", "-", "1"}], "2"], ",", "2"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"p", "-", "1"}], "2"], ",", "3"}], "]"}], ",", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"q", "-", "1"}], "2"], ",", "3"}], "]"}]}], 
            "\[IndentingNewLine]", "}"}], ",", " ", "t"}], "}"}]}], 
        "\[IndentingNewLine]", ")"}], "&"}], "/@", " ", "data"}], ")"}], 
    "\[Transpose]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.884139804810955*^9, 3.8841398186998053`*^9}, {
   3.8841398763324823`*^9, 3.884139908192595*^9}, {3.884139980527625*^9, 
   3.884139982540186*^9}, {3.884140044029677*^9, 3.8841400645370197`*^9}, {
