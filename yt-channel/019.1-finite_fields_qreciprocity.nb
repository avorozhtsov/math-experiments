Cell[BoxData[{
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalQ]", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "11", ",", 
     RowBox[{"-", "11"}], ",", " ", 
     RowBox[{
      RowBox[{"-", "2"}], "/", "7"}], ",", " ", "..."}], " ", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[DoubleStruckCapitalR]", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"0", ",", "1", ",", "11", ",", 
    RowBox[{"-", "11"}], ",", 
    RowBox[{
     RowBox[{"-", "2"}], "/", "7"}], ",", 
    SqrtBox["2"], ",", 
    RadicalBox[
     RowBox[{"1", "+", 
      SqrtBox["2"]}], "3"], ",", "\[Pi]", ",", " ", "\[ExponentialE]", ",", 
    RowBox[{"1.01001000100001", ".."}], ",", "..."}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[DoubleStruckCapitalC]", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "1", ",", 
     RowBox[{"...", " ", "\[Pi]"}], ",", "...", ",", " ", 
     RowBox[{"1.5", " ", "-", " ", 
      RowBox[{"4.1", " ", "\[ImaginaryI]"}]}], ",", "  ", 
     RowBox[{
      SqrtBox["1.2"], " ", "-", " ", 
      RowBox[{"3", " ", "\[ImaginaryI]"}]}], ",", "..."}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[DoubleStruckCapitalR]", "[", "x", "]"}], "=", 
   RowBox[{"{", 
