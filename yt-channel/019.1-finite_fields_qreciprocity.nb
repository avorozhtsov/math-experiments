Cell[BoxData[
 RowBox[{
  RowBox[{"JacobiTable", "[", "primes_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", " ", "p", ",", "q"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{
        "primes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{
        "primes", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"JacobiSymbol", "[", 
           RowBox[{"p", ",", "q"}], "]"}], "\[Equal]", "0"}], ",", "1", ",", 
         RowBox[{"JacobiSymbol", "[", 
          RowBox[{"p", ",", "q"}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "primes", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "primes", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

