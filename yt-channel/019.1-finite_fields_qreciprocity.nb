  "9c88cfa8-e22d-4be8-8014-cc172b1d2a1f"],
 ".\n\:0438 \
\:043f\:043e\:0440\:0430\:0431\:043e\:0442\:0430\:0439\:0442\:0435 \:0441 \
\:044d\:0442\:0438\:043c \:0442\:043e\:0436\:0434\:0435\:0441\:0442\:0432\
\:043e\:043c.\n",
 StyleBox["2) ",
  FontWeight->"Bold"],
 "\:0414\:043e\:043a\:0430\:0436\:0438\:0442\:0435, \:0447\:0442\:043e \:0438\
\:0437 \:0442\:0440\:0451\:0445 \:0443\:0442\:0432\:0435\:0440\:0436\:0434\
\:0435\:043d\:0438\:0439 \:0434\:043b\:044f",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    RowBox[{"x", " ", "\[Element]", " ", 
     SubscriptBox["\[DoubleStruckCapitalF]", "p"]}], ",", 
    RowBox[{"x", " ", "\[NotEqual]", " ", "0"}]}]}]],ExpressionUUID->
  "c48846b0-4d57-4150-8203-6bf32e69bf65"],
 "\n",
 StyleBox["      (a) ", "Item"],
 StyleBox[Cell[BoxData[
  RowBox[{
