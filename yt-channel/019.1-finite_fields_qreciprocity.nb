Cell[BoxData[{
 RowBox[{
  RowBox[{"primes", "=", 
   RowBox[{"Prime", "[", 
    RowBox[{"Range", "[", "3000", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{"RandomChoice", "[", "primes", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"RandomChoice", "[", "primes", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"p", ",", "q", ",", " ", 
         RowBox[{
          RowBox[{"JacobiSymbol", "[", 
           RowBox[{"p", ",", "q"}], "]"}], "*", 
          RowBox[{"JacobiSymbol", "[", 
           RowBox[{"q", ",", "p"}], "]"}]}]}], "}"}]}], "\[IndentingNewLine]",
       ")"}], "&"}], "/@", 
    RowBox[{"Range", "[", "100000", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.884143525321562*^9, 3.884143643658971*^9}, {
  3.8841437828584642`*^9, 3.884143798576571*^9}, {3.884143967449436*^9, 
  3.884143971357122*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"8db4274b-8ddb-4e57-ae97-65e01926a5a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullData", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p", ",", "q", ",", "t"}], "}"}], "=", "#"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"p", "-", "1"}], "2"], ",", "2"}], "]"}], ",", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"q", "-", "1"}], "2"], ",", "2"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"p", "-", "1"}], "2"], ",", "3"}], "]"}], ",", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"q", "-", "1"}], "2"], ",", "3"}], "]"}], ",", 
             "\[IndentingNewLine]", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{"p", ",", "3"}], "]"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"p", ",", "5"}], "]"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"q", ",", "3"}], "]"}], ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"q", ",", "5"}], "]"}]}], "\[IndentingNewLine]", "}"}], 
           ",", " ", "t"}], "}"}]}], "\[IndentingNewLine]", ")"}], "&"}], "/@",
       " ", "data"}], ")"}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fs", ",", " ", "target"}], "}"}], " ", "=", 
   RowBox[{"fullData", "\[Transpose]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fsT", ",", " ", "targetT"}], "}"}], " ", "=", 
   RowBox[{
    RowBox[{"fullData", "\[LeftDoubleBracket]", 
     RowBox[{";;", "80000"}], "\[RightDoubleBracket]"}], "\[Transpose]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fsV", ",", " ", "targetV"}], "}"}], " ", "=", 
   RowBox[{
    RowBox[{"fullData", "\[LeftDoubleBracket]", 
     RowBox[{"80001", ";;"}], "\[RightDoubleBracket]"}], "\[Transpose]"}]}], 
  ";"}]}], "Input",
