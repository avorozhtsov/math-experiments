  "be91f3ee-8c2f-4e6a-9871-0f0b3a6a2bc9"],
 ". \[LineSeparator]If  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "m"], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "40fb2f37-d54e-44c0-a3c6-0d82f88abfbe"],
 "  run through all numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "..", ",", 
     RowBox[{"p", "-", "1"}]}], "}"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "bf44ed9d-25d1-447c-b541-7994fd1e875d"],
 " then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", "n"], "-", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "226b580a-94b5-46f3-8120-3f9de8638885"],
 " should have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "-", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b394f817-5415-47df-a1f0-62040de2197b"],
 " solutions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "=", 
     SuperscriptBox["x", "m"]}], ",", " ", 
    RowBox[{"x", " ", "=", " ", "1"}], ",", "2", ",", "3", ",", "...", ",", 
    " ", 
    RowBox[{"p", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "d88e5d1a-3c19-4753-a263-47b8190d28b3"],
 ". But polynomial  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", "n"], "-", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "f547f8a0-ea54-499d-9515-900cc0eb1e1a"],
 "  can\[CloseCurlyQuote]t have more then ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6388dbb3-f2b7-4c2d-90b4-30827356e0f4"],
 " different roots."
}], "Text",
 CellChangeTimes->{{3.884238209100477*^9, 3.88423833883906*^9}, {
   3.884238424028841*^9, 3.8842386427519407`*^9}, {3.884405876342156*^9, 
   3.8844061041865387`*^9}, {3.884406142557925*^9, 3.884406716114689*^9}, {
   3.884406798162484*^9, 3.884407099091668*^9}, {3.884407142603292*^9, 
   3.884407144282631*^9}, 3.8844073393631477`*^9, {3.8844074466730137`*^9, 
   3.884407446673355*^9}, {3.884407549995615*^9, 3.884407620611622*^9}, {
   3.884407673871354*^9, 3.884407675033367*^9}, {3.8844077094196177`*^9, 
   3.884407719014924*^9}, {3.884407755837364*^9, 3.884407780160529*^9}, {
   3.8844078166232023`*^9, 
   3.884407860629387*^9}},ExpressionUUID->"2cc79e36-47be-497e-a2f7-\
26ee66307cdf"],

Cell[TextData[{
 "\nIf GCD[p - 1, m] == 1, than \[Exists] n: m*n \[Congruent] 1 mod (p-1), \
and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["x", "m"], ")"}], "n"], "\[Congruent]", 
    SuperscriptBox["x", 
     RowBox[{"m", " ", "*", " ", "n"}]], "\[Congruent]", " ", 
    SuperscriptBox["x", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "-", "1"}], ")"}], "k"}], " ", "+", " ", "1"}]], 
    "\[Congruent]", 
    RowBox[{
     SuperscriptBox["x", "1"], " ", "mod", " ", 
     RowBox[{"(", "p", ")"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "1e6b2581-c247-492f-b908-7644c41c012f"],
 ".\nSo ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "m"], " "}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9d0256ec-5171-4205-94ca-f040ae9f79be"],
 " runs through all numbers  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "..", ",", 
     RowBox[{"p", "-", "1"}]}], "}"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "56361b14-8c25-4c21-9e05-e41bf469bba4"],
 " if GCD[p - 1, m]==1."
}], "Text",
 CellChangeTimes->{{3.884412764592123*^9, 3.88441280474842*^9}, {
  3.884412887435286*^9, 3.884413057554206*^9}, {3.884418736124811*^9, 
  3.884418736356387*^9}},ExpressionUUID->"c004be1d-e368-4efe-8f85-\
6067d236ea05"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Home work", "Subsubsection",
 CellChangeTimes->{{3.884412606252842*^9, 
  3.884412609939189*^9}},ExpressionUUID->"86be774a-c726-4470-8145-\
d88adfbb1d31"],

Cell[TextData[{
 StyleBox["1)",
  FontWeight->"Bold"],
 " Find the proof of small Fermat theorem:\n\t\t\t\t\t",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{"p", "-", "1"}]], "-", "1"}], "=", 
    RowBox[{
     RowBox[{"0", "  ", "for", " ", "x"}], " ", "\[Element]", " ", 
     SubscriptBox["\[DoubleStruckCapitalF]", "p"]}]}], ",", 
   RowBox[{"x", " ", "\[NotEqual]", " ", "0"}]}]],
  CellChangeTimes->{{3.884223038375271*^9, 3.884223165240196*^9}, {
   3.884223213389947*^9, 3.884223540746722*^9}, {3.884238685261368*^9, 
   3.8842387253656693`*^9}},ExpressionUUID->
  "674d942a-c953-4837-b455-e9a35f5bb212"],
 "\[LineSeparator]Notice that numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "...", ",", " ", 
     RowBox[{"p", "-", "2"}]}], "}"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "27c1199c-90e4-434f-afce-372d2bc71481"],
 " could be partitioned to pairs of mutually inverse \
numbers,\[LineSeparator]and numbers  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " "}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "1b19cb61-c9d9-474a-9e5c-d2f59ca03a37"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "-", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b5ad5bea-cf28-4c0d-8f34-7eba990ed103"],
 " are self inverses, so multiplication of all nonzero numbers from ",
 Cell[BoxData[
  SubscriptBox["\[DoubleStruckCapitalF]", "p"]],ExpressionUUID->
  "4e292d1f-1196-4af7-ace5-c44202725dc1"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "9918eb3f-bff8-4aaa-a6da-78c164039def"],
 ":\n\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"1", "*", "2", "*", "3"}], "..."}], "*", 
     RowBox[{"(", 
      RowBox[{"p", "-", "1"}], ")"}]}], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "a6226148-d172-42b0-99f2-5c4df5a85a7a"],
 ".\t\nConsider multiplication of all nonzero numbers from ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "7954d64c-e7ab-4aa1-930b-9bc778e2b5f9"],
 "-th row of multiplication table: \t\t\n\t\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "*", "a"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"2", "*", "a"}], ")"}], "*"}], "..."}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p", "-", "1"}], ")"}], "*", "a"}], ")"}]}], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "5b658962-1951-4cff-accf-c8d6da0d3732"],
 ".\nand finish the proof.\n",
 StyleBox["2)",
  FontWeight->"Bold"],
 "Proof that  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"for", " ", "x"}], " ", "\[Element]", " ", 
    SubscriptBox["\[DoubleStruckCapitalF]", "p"]}], ",", 
   RowBox[{"x", " ", "\[NotEqual]", " ", "0"}]}]],ExpressionUUID->
  "63b9f540-104a-44a6-b13c-7b71aa7ebdab"],
 " from ",
 StyleBox["(a)", "Item"],
 " (b) and (c)\n",
 StyleBox["      (a) ", "Item"],
 StyleBox[Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{"(", 
      RowBox[{"p", "-", "1"}], ")"}]], "-", "1"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "-", "1"}], ")"}], "/", "2"}]], "-", "1"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["x", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "-", "1"}], ")"}], "/", "2"}]], "+", "1"}], ")"}]}]}]], 
  "Item",
  CellChangeTimes->{{3.884223038375271*^9, 3.884223165240196*^9}, {
   3.884223213389947*^9, 3.884223540746722*^9}, {3.884238685261368*^9, 
   3.8842387253656693`*^9}},ExpressionUUID->
  "1007db9b-f231-480e-84f6-47ebbfef14dc"], "Item"],
 StyleBox[";\n      (b) ", "Item"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{"(", 
      RowBox[{"p", "-", "1"}], ")"}]], "-", "1"}], "=", "0", "  "}]],
  CellChangeTimes->{{3.884223038375271*^9, 3.884223165240196*^9}, {
   3.884223213389947*^9, 3.884223540746722*^9}, {3.884238685261368*^9, 
   3.8842387253656693`*^9}},ExpressionUUID->
  "f14851f7-f9d9-4aae-8756-ef1996d2ee36"],
 " (small Fermat Theorem);\n      ",
 StyleBox["(c)", "Item"],
 " polynomial with\[NonBreakingSpace]k  different roots has degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GreaterEqual]", "  "}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "6540a69f-f4a8-46ac-8259-682d190b36c5"],
 " k ;\nwe can infer Legendre Symbol formula:\n\t",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    FractionBox["m", "p"], ")"}], " ", "\[Equal]", " ", 
   RowBox[{
    SuperscriptBox["m", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "1"}], ")"}], "/", "2"}]], "  ", "mod", " ", "p", "  ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"use", " ", "1", " ", "and"}], " ", "-", "1"}], ",", " ", 
      RowBox[{
       RowBox[{"not", " ", "p"}], "-", "1"}]}], ")"}]}]}]],
  CellChangeTimes->{{3.884223038375271*^9, 3.884223165240196*^9}, {
   3.884223213389947*^9, 3.884223540746722*^9}, {3.884238685261368*^9, 
   3.8842387253656693`*^9}},ExpressionUUID->
  "d067f045-93c0-485b-a948-e193c094fc22"]
}], "Text",
 CellChangeTimes->{{3.884238209100477*^9, 3.88423833883906*^9}, {
   3.884238424028841*^9, 3.8842386427519407`*^9}, {3.884405876342156*^9, 
   3.8844061041865387`*^9}, {3.884406142557925*^9, 3.884406716114689*^9}, {
   3.884406798162484*^9, 3.884407099091668*^9}, {3.884407142603292*^9, 
   3.884407144282631*^9}, 3.8844073924214582`*^9, {3.884407919845229*^9, 
   3.8844082109591923`*^9}, {3.8844124074706697`*^9, 
   3.8844125450095863`*^9}, {3.884412604860956*^9, 3.8844126143240023`*^9}, {
   3.884413078074748*^9, 3.884413155003036*^9}, {3.884414825367652*^9, 
   3.8844148905145807`*^9}},ExpressionUUID->"50287213-d861-4d61-8607-\
61898f545a07"],

