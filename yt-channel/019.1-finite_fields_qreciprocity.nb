  RowBox[{"ll", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"p", "=", "#"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"p", ",", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"x", " ", "y"}], "\[Equal]", "1"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}], ",", 
             RowBox[{"Modulus", "\[Rule]", "p"}]}], "]"}], "]"}], "-", 
