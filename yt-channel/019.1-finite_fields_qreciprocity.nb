Cell[BoxData[
 RowBox[{
  RowBox[{"JacobiSimTable", "[", "primes_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", " ", "p", ",", "q"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{
        "primes", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{
        "primes", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"JacobiSymbol", "[", 
            RowBox[{"p", ",", "q"}], "]"}], "*", 
           RowBox[{"JacobiSymbol", "[", 
            RowBox[{"q", ",", "p"}], "]"}]}], "\[Equal]", "0"}], ",", "1", 
         ",", 
         RowBox[{
          RowBox[{"JacobiSymbol", "[", 
           RowBox[{"p", ",", "q"}], "]"}], "*", 
          RowBox[{"JacobiSymbol", "[", 
           RowBox[{"q", ",", "p"}], "]"}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "primes", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "primes", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 CellChangeTimes->{{3.88459487404246*^9, 3.884594886116269*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"d44821f5-89be-4eef-a051-5691348e070f"],

