Cell[CellGroupData[{

Cell["Not fields \[Dash] division is not defined (not for all)", \
"Subsubsection",
 CellChangeTimes->{
  3.88431878704888*^9, {3.8843188654188423`*^9, 3.884318881924162*^9}, {
   3.884318934440873*^9, 3.8843189440276423`*^9}, {3.884319212753175*^9, 
   3.8843192342864532`*^9}},ExpressionUUID->"680666e0-03c0-4ad2-a4ff-\
5a7fbe63a112"],

Cell[TextData[{
 "\[DoubleStruckCapitalN] = {1, 2, 3, 4, ...}; (* problems with subtraction \
and division *)\n\[DoubleStruckCapitalZ] = {0, -1, 1, 2, -2, 3, -3, ...};  (* \
problems only with division *)\n\[DoubleStruckCapitalZ] (x) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", 
     RowBox[{"-", "7"}], ",", "113", ",", " ", 
     RowBox[{"3", "+", "x"}], ",", 
     RowBox[{"2", "-", 
      RowBox[{"5", 
       SuperscriptBox["x", "2"]}]}], ",", " ", 
     RowBox[{"x", "+", 
      SuperscriptBox["x", "3"], "+", 
      SuperscriptBox["x", "6"]}], ",", " ", 
     RowBox[{"1000", " ", 
      SuperscriptBox["x", "1000"]}], ",", "..."}], "}"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "91fe0499-0480-4ac6-b295-542aa022ca49"],
 "\n\[DoubleStruckCapitalZ] (x) = {P[x] | P  is polynomial of x, coeffs in \
\[DoubleStruckCapitalZ]};  (* problems only with division *)\n\
\[DoubleStruckCapitalZ] (x), \[DoubleStruckCapitalQ] (x),  \
\[DoubleStruckCapitalR] (x) \[Dash] rings of polynomials.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[DoubleStruckCapitalN]", " ", "\[Subset]", " ", 
    "\[DoubleStruckCapitalZ]", " ", "\[Subset]", " ", 
    "\[DoubleStruckCapitalQ]", "\[Subset]", " ", "\[DoubleStruckCapitalR]", 
    " ", "\[Subset]", " ", "\[DoubleStruckCapitalC]"}], TraditionalForm]], 
  "DisplayFormula",
  FormatType->"TraditionalForm",
  FontWeight->"Plain",ExpressionUUID->
  "452c7b5b-d149-4f97-bfbc-784269f10e57"],
 " \n\[DoubleStruckCapitalC] could be constructed as equivalence classes in \
\[DoubleStruckCapitalR] (x). "
}], "Text",
 CellChangeTimes->{{3.8843183611678867`*^9, 3.8843186230019283`*^9}, {
   3.884318710921103*^9, 3.884318858243133*^9}, {3.8843199071937733`*^9, 
   3.884319909081194*^9}, {3.8843199453063498`*^9, 3.884319988031454*^9}, 
   3.884320249125433*^9, {3.884322069109585*^9, 3.8843221500685863`*^9}, {
   3.88432231846655*^9, 3.8843224044086027`*^9}, {3.8843224707719707`*^9, 
   3.88432251485257*^9}, {3.8843225814769897`*^9, 3.884322687747078*^9}, 
   3.884445112228512*^9},ExpressionUUID->"5a703d39-e3a5-4714-805d-\
ee030dbf371c"]
}, Open  ]],

