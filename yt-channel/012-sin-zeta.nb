      "Body" :> ($CellContext`a = (ListPlot[#, AspectRatio -> 1]& )[
          Transpose[
           ({
            Re[#], 
            Im[#]}& )[
            N[
             ReplaceAll[$CellContext`x, 
              
              Solve[$CellContext`PolyG[(4 Pi/
                  3) (($CellContext`x + 
                   0/$CellContext`m$$)/$CellContext`m$$), $CellContext`m$$] == 
