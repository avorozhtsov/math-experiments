       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "/.", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"PolySig", "[", " ", 
               RowBox[{
                RowBox[{"\[Pi]", " ", "x"}], ",", "m"}], "]"}], "\[Equal]", 
              "0"}], ",", "x"}], "]"}]}], ")"}], "//", "N"}], "//", 
