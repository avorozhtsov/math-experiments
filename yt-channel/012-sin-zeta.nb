Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", 
      RowBox[{"-", "m"}]}], "m"], 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "k"], 
     RowBox[{"x", "-", 
      RowBox[{"k", " ", "\[Pi]"}]}]]}]], "==", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], "+", 
   RowBox[{"x", " ", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"2", "x"}], "]"}], "-", "1"}], ")"}], 
     RowBox[{"20", " ", 
      SuperscriptBox["m", "2"]}]]}]}]}]], "Input",
