     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "/.", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"PolyG", "[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"4", " ", "\[Pi]"}], "3"], " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", "+", 
                  RowBox[{"0.5", "/", "m"}]}], ")"}], "/", "m"}]}], ",", 
              "m"}], "]"}], "\[Equal]", "0"}], ",", "x"}], "]"}]}], ")"}], "//",
        "N"}], "//", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "#", "]"}], ",", 
         RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}]}], "//", "Transpose"}],
