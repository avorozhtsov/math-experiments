         ListPlot[#, AspectRatio -> 1, PlotStyle -> RGBColor[0.81, 0.24, 0.5],
           PlotRange -> {{-1.1, 1.1}, {-1.1, 1.1}}]& )[
          Transpose[
           ({
            Re[#], 
            Im[#]}& )[
            N[
             ReplaceAll[$CellContext`x, 
              
              Solve[$CellContext`PolySig[Pi $CellContext`x, $CellContext`m$$] == 
               0, $CellContext`x]]]]]]; Show[$CellContext`b, $CellContext`a, 
         Graphics[
          Circle[{0, 0}, 1]], 
         Graphics[
          Circle[{0, 0}, 1 - 1/($CellContext`m$$ + 1)^(3/4)]], 
         Graphics[
          Circle[{0, 0}, 1 - 2/($CellContext`m$$ + 1)^(3/4)]]]), 
      "Specifications" :> {{{$CellContext`m$$, 7}, 2, 200, 1}}, 
