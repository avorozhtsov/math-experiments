Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "g", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "m_"}], "]"}], ":=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"k", "=", 
     RowBox[{"-", "m"}]}], "m"], 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "k"], 
    RowBox[{"x", "-", 
     RowBox[{"k", " ", "\[Pi]"}]}]]}]}]}], "Input",
 CellChangeTimes->{{3.859178580698653*^9, 3.8591786332889643`*^9}, {
