Cell[BoxData[
 RowBox[{
  RowBox[{"ExpSlice", "[", 
   RowBox[{"l_", ",", " ", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "step"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m", " ", "=", " ", 
      RowBox[{"Length", "[", "l", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"step", " ", "=", " ", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"N", "[", "m", "]"}], "]"}], "/", "n"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"l", "\[LeftDoubleBracket]", " ", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Round", "[", "  ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], " ", "*", " ", "step"}], "]"}], 
        " ", "]"}], "]"}], " ", "\[RightDoubleBracket]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.839843871204257*^9, 3.839843996888357*^9}, {
  3.83984404255589*^9, 3.839844079635214*^9}, {3.839848122190528*^9, 
  3.839848132555956*^9}},
 CellLabel->
  "In[205]:=",ExpressionUUID->"f5d7aae2-4abf-41e6-a313-d4e2ef8d5d53"],

