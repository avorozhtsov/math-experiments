Cell[BoxData[{
 RowBox[{
  RowBox[{"ns", " ", "=", "powersLOdd"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", " ", "=", " ", 
   RowBox[{"Accumulate", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"JacobiSymbol", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EulerPhi", "[", "#", "]"}], "+", "1"}], ",", " ", "#"}], 
        "]"}], "&"}], "/@", "ns"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xy", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"N", "[", "ns", "]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"N", "[", "l", "]"}], "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"N", "[", "ns", "]"}], "]"}]}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"ExpSlice", "[", 
   RowBox[{"xy", ",", "10000"}], "]"}], "]"}]}], "Input",
