Cell[BoxData[{
 RowBox[{
  RowBox[{"ns", " ", "=", "powersLOdd"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", " ", "=", " ", 
   RowBox[{"Accumulate", "@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"JacobiSymbol", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "#"}], "]"}], "&"}], "/@", "ns"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xy", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"N", "[", "ns", "]"}], "]"}], ",", " ", 
       RowBox[{"l", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"N", "[", "ns", "]"}], "]"}]}]}], "}"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
