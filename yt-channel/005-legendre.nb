Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NumberFaceB", "[", "p_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "n", ",", " ", "pt1", ",", "pt2", ",", "path"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"path", "=", 
       RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"n", "=", "#"}], ";", "\[IndentingNewLine]", 
              RowBox[{"m", "=", 
               RowBox[{"PolynomialMod", "[", 
                RowBox[{
                 RowBox[{"1", "/", "n"}], ",", " ", "p"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"pt1", "=", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Sin", "[", 
                  RowBox[{"m", " ", "2", " ", 
                   RowBox[{"Pi", " ", "/", " ", "p"}]}], "]"}], ",", " ", 
                 RowBox[{"-", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"m", " ", "2", " ", 
                    RowBox[{"Pi", " ", "/", " ", "p"}]}], "]"}]}]}], "}"}]}], 
              " ", ";", "\[IndentingNewLine]", 
              RowBox[{"pt2", "=", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Sin", "[", 
                  RowBox[{"n", " ", "2", " ", 
                   RowBox[{"Pi", " ", "/", " ", "p"}]}], "]"}], ",", " ", 
                 RowBox[{"-", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"n", " ", "2", " ", 
                    RowBox[{"Pi", " ", "/", " ", "p"}]}], "]"}]}]}], "}"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"pt1", ",", 
                RowBox[{"pt1", "+", "pt2"}]}], "}"}]}], "\[IndentingNewLine]",
              ")"}], "&"}], "/@", 
           RowBox[{"Coprimes", "[", "p", "]"}]}], "\[IndentingNewLine]", 
          ")"}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{"Joined", "\[Rule]", "True"}], ",", 
         RowBox[{"Axes", "\[Rule]", "False"}], ",", 
         RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
         RowBox[{"Mesh", "\[Rule]", "All"}], ",", " ", 
         RowBox[{"Epilog", "\[Rule]", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"\"\<p=\>\"", "<>", 
             RowBox[{"ToString", "[", "p", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"Center", ",", "Center"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"p", ",", "60"}], "]"}], "+", "1"}], "]"}], "[", 
            RowBox[{"Mod", "[", 
             RowBox[{"p", ",", "7"}], "]"}], "]"}], "}"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{"path", ",", " ", 
        RowBox[{"Graphics", "[", 
         RowBox[{"Circle", "[", "]"}], "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetAttributes", "[", 
  RowBox[{"NumberFaceB", ",", " ", "Listable"}], "]"}]}], "Input",
